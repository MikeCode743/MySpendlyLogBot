# ─────────────────────────────────────────────
# DonDineroBot — Variables de entorno
# Renombra este archivo a .env y llena los valores
# ─────────────────────────────────────────────

# Token de tu bot (lo da @BotFather en Telegram)
TELEGRAM_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key de Anthropic (platform.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre exacto de tu Google Sheet (tal como aparece en Drive)
GOOGLE_SHEET_NAME=Mis Finanzas 2026

# Ruta al archivo de credenciales de Google (Service Account)
GOOGLE_CREDENTIALS_FILE=credentials.json
