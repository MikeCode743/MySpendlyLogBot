# ─────────────────────────────────────────────
# MySpendlyLogBot — Variables de entorno
# Renombra este archivo a .env y llena los valores
# ─────────────────────────────────────────────

# Token de tu bot (lo da @BotFather en Telegram)
TELEGRAM_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre exacto de tu Google Sheet
GOOGLE_SHEET_NAME=Mis Finanzas 2026

# Solo para desarrollo local (en Railway se usa GOOGLE_CREDENTIALS_JSON)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Para Railway: pega aquí el contenido del credentials.json en una sola línea
# Genera con: python3 -c "import json; f=open('credentials.json'); print(json.dumps(json.load(f)))"
GOOGLE_CREDENTIALS_JSON=
